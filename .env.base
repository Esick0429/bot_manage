# 环境
VITE_NODE_ENV=development

# 接口前缀
VITE_API_BASE_PATH=http://192.168.31.250:2404

# 打包路径
VITE_BASE_PATH=/

# 标题
VITE_APP_TITLE='机器人后台管理系统'

# 操作后台标题
VITE_APP_TITLE_OPERATION='机器人后台运营系统'

# 是否全量引入element-plus样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=true

# 是否开启mock
VITE_USE_MOCK=true

# 需要mock的接口
VITE_MOCK_LIST=/energy_order,/hosted_order,/exchange_order,/statistics
# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=true

VITE_SYSTEM_TYPE='Management'